# Copy to .env and fill in. Every setting is optional except where noted: the defaults
# in packages/sift_core/config.py run the whole stack locally against docker-compose.
#
#   cp .env.example .env
#
# .env is gitignored. Nothing secret belongs in this file.

# ---- datastores ----
# Defaults match docker-compose.yml, so leave these alone for local development.
SIFT_DATABASE_URL=postgresql://sift:sift@localhost:5432/sift
SIFT_REDIS_URL=redis://localhost:6379/0
# Keep under the server's connection limit divided by replica count. The deployed
# Postgres is a B1ms, which is why production sets 5 rather than the default 8.
SIFT_DB_POOL_MAX=8

# ---- embeddings ----
# `local` runs BAAI/bge-small-en-v1.5 through ONNX with no cloud account at all, which
# is what makes a key-free checkout able to ingest and search. `azure_openai` is faster
# (38 chunks/s against 5) and scores better, and is what the deployed corpus was built
# with.
SIFT_EMBEDDING_PROVIDER=local
# Must match the width the active corpus was ingested at, or every query fails: pgvector
# refuses to compare vectors of different widths. /ready reports the mismatch by name.
SIFT_EMBEDDING_DIMENSIONS=768

# ---- Azure OpenAI ----
# Required for `SIFT_EMBEDDING_PROVIDER=azure_openai`, for /api/ask, and for the answer
# evaluation. Without them the API still serves search, and /api/ask returns 503.
SIFT_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
SIFT_AZURE_OPENAI_API_KEY=
SIFT_AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Deployment names are chosen when you deploy the model and need not match the model.
SIFT_AZURE_CHAT_DEPLOYMENT=gpt-4.1-mini
# Used by the evaluation judge, not by the product.
SIFT_AZURE_REASONING_DEPLOYMENT=gpt-5-mini

# ---- agent ----
# Loop bounds. Measured: raising depth to 10 halves the hit-limit rate and changes
# judged correctness by nothing. See eval/results/ANSWERS.md.
SIFT_AGENT_MAX_DEPTH=6
SIFT_AGENT_MAX_TOOL_CALLS=12
SIFT_AGENT_MAX_COMPLETION_TOKENS=1200
# Per million tokens, for the cost figure returned with every answer. Change these when
# you change the chat deployment or every cost number quietly becomes wrong.
SIFT_CHAT_COST_PROMPT_PER_M=0.40
SIFT_CHAT_COST_COMPLETION_PER_M=1.60

# ---- ingestion ----
# Left unset, the worker talks to the Azurite emulator from docker-compose.
SIFT_STORAGE_CONNECTION_STRING=
SIFT_QUEUE_NAME=sift-ingest

# ---- serving ----
SIFT_LOG_LEVEL=INFO
# Per-client ceiling on /api/ask, which is the endpoint that spends money. 0 disables.
SIFT_ASK_RATE_LIMIT_PER_MINUTE=10

# ---- infrastructure only ----
# Read by scripts/deploy.sh and the Bicep parameters, not by the application.
SIFT_PG_ADMIN_PASSWORD=
