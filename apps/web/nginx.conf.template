# Rendered at container start by the nginx image's envsubst entrypoint, which
# substitutes ${SIFT_API_ORIGIN} and ${NGINX_LOCAL_RESOLVERS}.
#
# ${SIFT_API_ORIGIN} must be a resolvable absolute origin. The first deploy failed
# because the config carried an `upstream api:8000` block naming a host that exists
# only in docker compose: nginx resolves upstream names once at startup and aborts if
# one does not resolve, so the container died before serving a request and Container
# Apps reported ActivationFailed with no logs at all.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Hashed asset filenames are immutable; index.html must never be cached or a
    # deploy leaves clients pinned to a stale bundle.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # No limit_req here, deliberately. Behind Container Apps ingress $remote_addr is the
    # ingress rather than the caller, so a zone keyed on it would put every user in one
    # bucket and throttle them collectively - worse than not limiting. Keying on
    # X-Forwarded-For needs set_real_ip_from over ingress ranges that are not fixed. The
    # ceiling that matters is on /api/ask, which spends money, and it lives in the
    # application where the forwarded address is already parsed. See apps/api/ratelimit.py.
    location /api/ {
        proxy_pass ${SIFT_API_ORIGIN};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Streaming answers must not be buffered, or the client sees nothing until the
        # response is complete - which defeats the point of streaming.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location = /ready {
        proxy_pass ${SIFT_API_ORIGIN};
        # Without this nginx proxies as HTTP/1.0, and Container Apps answers HTTP/1.0
        # with 426 Upgrade Required. It is not optional just because the block is small.
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
    }

    # nginx's own liveness, answered without reaching the API.
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
